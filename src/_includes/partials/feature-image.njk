{% if post.data.image %}
    <figure class="gh-article-image">
        <img class="u-featured"
            src="{{ post.data.image }}"
            alt="{{ post.data.image_alt or post.data.title }}"
			{% if post.data.image_width %}width="{{ post.data.image_width }}"{% endif %}
			{% if post.data.image_height %}height="{{ post.data.image_height }}"{% endif %}
            sizes="(max-width: 1200px) 100vw, 1200px"
            loading="eager"
            fetchpriority="high"
                    >
        {% if post.data.image_caption %}
            <figcaption>{{ post.data.image_caption | safe }}</figcaption>
        {% endif %}
    </figure>
{% endif %}
