{#- Everything inside <head>: SEO, no-flash theme script, styles, Pagefind. -#}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ eleventy.generator }}">

{%- set pageTitle = title or metadata.title %}
{%- set pageDesc = description or custom_excerpt or excerpt or metadata.description %}
{%- set pageImage = feature_image or cover_image or metadata.cover_image %}
<title>{% if title %}{{ title }} — {{ metadata.title }}{% else %}{{ metadata.title }}{% endif %}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ metadata.url }}{{ page.url or '/' }}">

{#- Open Graph / Twitter -#}
<meta property="og:site_name" content="{{ metadata.title }}">
<meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ metadata.url }}{{ page.url or '/' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
{%- if pageImage %}
<meta property="og:image" content="{% if pageImage.startsWith('http') %}{{ pageImage }}{% else %}{{ metadata.url }}{{ pageImage }}{% endif %}">
<meta property="og:image:alt" content="{{ feature_image_alt or pageTitle }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{% if pageImage.startsWith('http') %}{{ pageImage }}{% else %}{{ metadata.url }}{{ pageImage }}{% endif %}">
{%- else %}
<meta name="twitter:card" content="summary">
{%- endif %}

<link rel="icon" href="{{ metadata.icon or '/favicon.svg' }}"{% if (metadata.icon or '/favicon.svg').endsWith('.svg') %} type="image/svg+xml"{% endif %}>
<link rel="alternate" type="application/atom+xml" title="{{ metadata.title }} (Atom)" href="/feed.xml">
<link rel="alternate" type="application/rss+xml" title="{{ metadata.title }} (RSS)" href="/feed/feed.rss">
<link rel="alternate" type="application/feed+json" title="{{ metadata.title }} (JSON)" href="/feed/feed.json">
{#- Bridgy Fed: verifies the site link (green check) on the bridged Mastodon profile. -#}
<link rel="me" href="https://web.brid.gy/r/{{ metadata.url }}/">
{%- for href in metadata.rel_me %}
<link rel="me" href="{{ href }}">
{%- endfor %}
{#- Webmentions (incl. Bridgy Fed backfeed of Mastodon/Bluesky replies, likes, reposts) are received
    by webmention.io and baked in at build time: see src/_data/webmentions.js. -#}
<link rel="webmention" href="https://webmention.io/publictheology.com/webmention">
<link rel="pingback" href="https://webmention.io/publictheology.com/xmlrpc">
{%- if layout == 'layouts/post.njk' %}
{#- Lets Mastodon users find the bridged post by pasting its URL into search (Bridgy Fed docs). -#}
<link rel="alternate" type="application/activity+json" href="https://fed.brid.gy/r/{{ metadata.url }}{{ page.url }}">
{%- endif %}
<link rel="alternate" type="application/xml" title="{{ metadata.title }} OAI-PMH static repository" href="/oai.xml">

{#- Cloudflare Web Analytics injects its beacon (crossorigin="anonymous") at the edge; warm the connection. -#}
<link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin>
<link rel="dns-prefetch" href="https://static.cloudflareinsights.com">

{#- Preoptimized source images are copied as-is; preload only the page hero. -#}
{%- if feature_image and not feature_image.startsWith('http') %}
<link rel="preload" as="image" href="{{ feature_image }}" fetchpriority="high">
{%- endif %}

{#- Structured data (JSON-LD), autofilled from metadata via _data/schema.js:
    WebSite on every page, Blog on the homepage, BlogPosting + Zotero-harvestable
    citation metadata on posts. -#}
<script type="application/ld+json">{{ schema.siteGraph | dump | safe }}</script>
{%- if layout == 'layouts/post.njk' %}
{%- set ldAuthors = authors | resolveAuthors(siteAuthors) %}
{%- set imageAbs = "" %}
{%- if feature_image %}{% set imageAbs = feature_image if feature_image.startsWith('http') else metadata.url + feature_image %}{% endif %}
{%- set postLd = { title: title, description: pageDesc, url: metadata.url + page.url, date: (page.date | rfc3339), lang: schema.language, image: imageAbs, authors: ldAuthors, siteUrl: metadata.url, siteName: metadata.title, blogId: schema.blogId, publisher: schema.publisher } | postingLd %}
<script type="application/ld+json">{{ postLd | dump | safe }}</script>
{#- Zotero: zotero:itemType forces "Blog Post" (needs the zotero: prefix on <html>).
    citation_title / citation_journal_title are deliberately absent: the first makes
    Zotero guess journalArticle, the second forces it. The title rides on og:title/DC.title. -#}
{%- set citeUrl = metadata.url + page.url %}
{%- set citeDate = page.date | htmlDateString %}
{%- set citeSubjects = (categories | taxonomyTerms('category')).concat((postTags | resolvedPostTags(tags)) | taxonomyTerms('tag')) %}
<link rel="type" href="https://schema.org/BlogPosting">
<meta property="zotero:itemType" content="blogPost">
<meta name="prism.genre" content="blogentry">
<meta name="prism.publicationName" content="{{ metadata.title }}">
<meta name="prism.url" content="{{ citeUrl }}">
{%- for a in ldAuthors %}
<meta name="citation_author" content="{{ a.name }}">
{%- endfor %}
<meta name="citation_publication_date" content="{{ page.date | readableDate('yyyy/LL/dd') }}">
<meta name="citation_online_date" content="{{ page.date | readableDate('yyyy/LL/dd') }}">
<meta name="citation_fulltext_html_url" content="{{ citeUrl }}">
<meta name="citation_public_url" content="{{ citeUrl }}">
<meta name="citation_publisher" content="{{ metadata.organization.name or metadata.title }}">
<meta name="citation_language" content="{{ schema.language }}">
{%- for s in citeSubjects %}
<meta name="citation_keywords" content="{{ s.name }}">
{%- endfor %}
{#- Dublin Core (DC-HTML), mirroring the oai_dc record in /oai.xml. -#}
<link rel="schema.DC" href="http://purl.org/dc/elements/1.1/">
<link rel="schema.DCTERMS" href="http://purl.org/dc/terms/">
<meta name="DC.title" content="{{ title }}">
{%- for a in ldAuthors %}
<meta name="DC.creator" content="{{ a.name }}">
{%- endfor %}
{%- for s in citeSubjects %}
<meta name="DC.subject" content="{{ s.name }}">
{%- endfor %}
{%- if custom_excerpt %}
<meta name="DC.description" content="{{ custom_excerpt }}">
{%- endif %}
<meta name="DC.publisher" content="{{ metadata.title }}">
<meta name="DC.date" scheme="DCTERMS.W3CDTF" content="{{ citeDate }}">
<meta name="DCTERMS.issued" scheme="DCTERMS.W3CDTF" content="{{ citeDate }}">
<meta name="DC.type" scheme="DCTERMS.DCMIType" content="Text">
<meta name="DC.format" scheme="DCTERMS.IMT" content="text/html">
<meta name="DC.identifier" scheme="DCTERMS.URI" content="{{ citeUrl }}">
<meta name="DC.language" scheme="DCTERMS.RFC4646" content="{{ schema.language }}">
<meta name="DCTERMS.isPartOf" scheme="DCTERMS.URI" content="{{ metadata.url }}/">
<meta name="DC.rights" content="{{ metadata.footer.license }}">
<meta name="DCTERMS.license" scheme="DCTERMS.URI" content="{{ metadata.footer.license_url }}">
{%- endif %}

{#- No-flash: set the colour scheme before first paint. -#}
<script>
	(function () {
		try {
			var stored = localStorage.getItem("headline-color-scheme");
			var scheme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
			document.documentElement.setAttribute("data-theme", scheme);
		} catch (e) {
			document.documentElement.setAttribute("data-theme", "{{ theme.default_color_scheme or 'light' }}");
		}
	})();
</script>

{#- All CSS is inlined (no render-blocking requests): src/_data/inlineCss.js joins the theme's
    screen.css (minus its @font-face rules), fonts.css, site.css and darkmode.css. Edit those files.
    Pagefind Component UI is lazy-loaded on first search intent by /assets/js/pagefind-loader.js. -#}
<style>{{ inlineCss | safe }}</style>
{#- font-display:optional skips a face that misses first paint; preload the two most visible
    (body text, titles) so they make it. The other weights arrive and are cached for the next page. -#}
<link rel="preload" href="/assets/fonts/lora-v25-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-v12-latin-700.woff2" as="font" type="font/woff2" crossorigin>
