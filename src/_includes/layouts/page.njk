---
layout: layouts/default.njk
bodyClass: page-template
---
{#- Static page layout (was page.hbs). `show_header`
    defaults to true when not set in front matter. -#}
{% set post = {
	url: page.url,
	date: page.date,
	content: content,
	data: {
		title: title,
		description: description,
		image: image,
		image_alt: image_alt,
		image_caption: image_caption,
		image_width: image_width,
		image_height: image_height,
		authors: authors,
		tags: tags,
		template: template
	}
} %}

<main class="gh-main">
	{% include "partials/breadcrumbs.njk" %}
	<article class="gh-article page" data-pagefind-body>

		{% if show_header != false %}
			<header class="gh-article-header gh-canvas">
				<h1 class="gh-article-title">{{ title }}</h1>

				{% if description %}
					<p class="gh-article-excerpt">{{ description }}</p>
				{% endif %}

				{% include "partials/feature-image.njk" %}
			</header>
		{% endif %}

		<section class="gh-content gh-canvas">
			{{ content | safe }}
		</section>

	</article>
</main>
