---
layout: layouts/default.njk
bodyClass: author-template
---
{%- set author = (page.fileSlug | resolveAuthors(siteAuthors))[0] %}
<main class="gh-main gh-outer">
	<div class="gh-inner">
		<section class="gh-pagehead h-card" itemscope itemtype="https://schema.org/Person">
			<a class="u-url u-uid" href="{{ metadata.url }}{{ page.url }}" hidden aria-hidden="true" tabindex="-1"></a>
			<figure class="gh-author-image">
				{% if author.profile_image %}
					<img class="u-photo" itemprop="image" src="{{ author.profile_image }}" alt="{{ author.name }}">
				{% else %}
					<div class="gh-author-icon">{% include "partials/icons/avatar.njk" %}</div>
				{% endif %}
			</figure>

			<div class="gh-pagehead-content">
				<h1 class="gh-pagehead-title p-name" itemprop="name">{{ author.name }}</h1>
				{% if author.role %}
					<div class="gh-author-location p-job-title" itemprop="jobTitle">{{ author.role }}</div>
				{% endif %}
				{% if content | trim %}
					<div class="gh-author-bio gh-pagehead-description p-note">{{ content | safe }}</div>
				{% endif %}
				{#- Every profile field, as visible labelled links (not icon-only). -#}
				<ul class="author-links">
					{%- for f in [["orcid","ORCID","orcid"],["hcommons","Humanities Commons","website"],["website","Website","website"],["bluesky","Bluesky","bluesky"],["mastodon","Mastodon","mastodon"],["x","X","x"]] %}
					{%- if author[f[0]] %}
					<li><a class="u-url" href="{{ author[f[0]] }}" rel="me noopener" target="_blank">{% include "partials/icons/" + f[2] + ".njk" %}<span>{{ f[1] }}</span></a></li>
					{%- endif %}
					{%- endfor %}
					{%- if author.email %}
					<li><a class="u-email" href="mailto:{{ author.email }}">{% include "partials/icons/email.njk" %}<span>{{ author.email }}</span></a></li>
					{%- endif %}
				</ul>
			</div>
		</section>

		<div class="gh-topic gh-topic-grid">
			<div class="gh-topic-content gh-feed">
				{#- Match on resolved slugs: post authors may be slugs or Pages CMS paths (src/authors/x.md). -#}
				{% for post in collections.posts | postsByAuthor(author.key, siteAuthors) %}
					{% include "partials/loop-grid.njk" %}
				{% else %}
					<p>No posts yet.</p>
				{% endfor %}
			</div>
		</div>
	</div>
</main>
