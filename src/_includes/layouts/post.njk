---
layout: layouts/default.njk
bodyClass: post-template
---
{#- Post layout (was post.hbs / custom-full-feature-image.hbs /
    custom-wide-feature-image.hbs). Branches on the `template` front
    matter field. Shared partials receive a uniform `post` object. -#}
{% set resolvedTags = tags | publicTags %}
{% set post = {
	url: page.url,
	date: page.date,
	content: content,
	data: {
		title: title,
		description: description,
		image: image,
		image_alt: image_alt,
		image_caption: image_caption,
		image_width: image_width,
		image_height: image_height,
		authors: authors,
		tags: resolvedTags,
		categories: categories,
		template: template,
		modified: modified
	}
} %}
{% set primaryTag = (resolvedTags | taxonomyTerms('tag'))[0] %}

{% if template == "full-feature-image" %}
{#- custom-full-feature-image.hbs: full-bleed cover, then article -#}
{% if image %}
	<section class="gh-cover loading gh-outer">
		<img
			class="gh-cover-image u-featured"
			src="{{ image }}"
			alt="{{ image_alt or title }}"
			{% if image_width %}width="{{ image_width }}"{% endif %}
			{% if image_height %}height="{{ image_height }}"{% endif %}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
					>

		<div class="gh-cover-content">
			{% if primaryTag %}
				<a class="gh-article-tag" href="{{ primaryTag.url }}">{{ primaryTag.name }}</a>
			{% endif %}

			<h1 class="gh-cover-title p-name" itemprop="headline name">{{ title }}</h1>
		</div>
	</section>
{% endif %}

<main class="gh-main">
	{% include "partials/breadcrumbs.njk" %}
	<article class="gh-article post h-entry" data-pagefind-body itemscope itemtype="https://schema.org/BlogPosting">
		<a class="u-url" href="{{ page.url }}" hidden aria-hidden="true"></a>
		<a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden="from-humans"></a>
		{%- for t in (categories | taxonomyTerms('category')).concat(resolvedTags | taxonomyTerms('tag')) %}<data class="p-category" value="{{ t.name }}"></data>{% endfor %}
		<header class="gh-article-header gh-canvas">
			{% include "partials/post-meta.njk" %}

			{% if description %}
				<p class="gh-article-excerpt p-summary">{{ description }}</p>
			{% endif %}
		</header>

		<section class="gh-content gh-canvas e-content{% if toc %} has-toc{% endif %}" itemprop="articleBody">
			{% if toc %}{% include "partials/toc.njk" %}{% endif %}
			{{ ((content | tocBacklinks) if toc else content) | safe }}
		</section>
	</article>
	{% include "partials/post-citation.njk" %}
	{% include "partials/post-taxonomy.njk" %}
	{% include "partials/webmentions.njk" %}

	{% include "partials/related-posts.njk" %}

	{% include "partials/comments.njk" %}
</main>
{% else %}
{#- post.hbs (default, also used for "wide-feature-image") -#}
<main class="gh-main">
	{% include "partials/breadcrumbs.njk" %}
	<article class="gh-article post h-entry" data-pagefind-body itemscope itemtype="https://schema.org/BlogPosting">
		<a class="u-url" href="{{ page.url }}" hidden aria-hidden="true"></a>
		<a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden="from-humans"></a>
		{%- for t in (categories | taxonomyTerms('category')).concat(resolvedTags | taxonomyTerms('tag')) %}<data class="p-category" value="{{ t.name }}"></data>{% endfor %}

		<header class="gh-article-header gh-canvas">
			{% if primaryTag %}
				<a class="gh-article-tag" href="{{ primaryTag.url }}">{{ primaryTag.name }}</a>
			{% endif %}

			<h1 class="gh-article-title p-name" itemprop="headline name">{{ title }}</h1>

			{% if description %}
				<p class="gh-article-excerpt p-summary">{{ description }}</p>
			{% endif %}

			{% include "partials/post-meta.njk" %}

			{% include "partials/feature-image.njk" %}
		</header>

		<section class="gh-content gh-canvas e-content{% if toc %} has-toc{% endif %}" itemprop="articleBody">
			{% if toc %}{% include "partials/toc.njk" %}{% endif %}
			{{ ((content | tocBacklinks) if toc else content) | safe }}
		</section>

	</article>
	{% include "partials/post-citation.njk" %}
	{% include "partials/post-taxonomy.njk" %}
	{% include "partials/webmentions.njk" %}

	{% include "partials/related-posts.njk" %}

	{% include "partials/comments.njk" %}
</main>
{% endif %}
